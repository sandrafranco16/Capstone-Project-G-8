NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CALCOM_URL=

# Decap CMS GitHub publishing. Keep the client secret server-side only.
CMS_REPOSITORY=
CMS_BRANCH=
CMS_OAUTH_BASE_URL=
CMS_GITHUB_CLIENT_ID=
CMS_GITHUB_CLIENT_SECRET=
# Use public_repo while the repository is public; change to repo if it becomes private.
CMS_GITHUB_SCOPE=

# Contact email delivery. Set CONTACT_EMAIL_PROVIDER to "mock" for local
# development (no real emails sent) or "resend" for preview/production.
CONTACT_EMAIL_PROVIDER=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_API_KEY=

# Cloudflare Turnstile spam protection.
# Leave blank to skip Turnstile verification during local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional analytics identifiers. Leave blank during local development.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
