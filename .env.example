NEXT_PUBLIC_SITE_URL=https://www.bitdot.com.au
NEXT_PUBLIC_CALCOM_URL=

# Decap CMS GitHub publishing. Keep the client secret server-side only.
CMS_REPOSITORY=Hjl2065889707/Capstone-Project-G-8
CMS_BRANCH=main
CMS_OAUTH_BASE_URL=https://your-stable-deployment.example.com
CMS_GITHUB_CLIENT_ID=
CMS_GITHUB_CLIENT_SECRET=
# Use public_repo while the repository is public; change to repo if it becomes private.
CMS_GITHUB_SCOPE=public_repo

# To be selected and configured before contact-form implementation.
CONTACT_EMAIL_PROVIDER=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_API_KEY=

# Optional analytics identifiers. Leave blank during local development.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
